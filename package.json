{
  "name": "@danmo/ui",
  "version": "0.1.0",
  "description": "澹墨设计系统 — 跨项目共享的轻量 React 组件库（设计令牌 + 原子组件，无业务耦合）",
  "type": "module",
  "main": "./dist/danmo-ui.js",
  "module": "./dist/danmo-ui.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/danmo-ui.js"
    },
    "./styles.css": "./dist/danmo-ui.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
